{
  "buildCommand": "echo done",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/api/proxy?slug=about" },
    { "source": "/blogs", "destination": "/api/proxy?slug=blogs" },
    { "source": "/careers", "destination": "/api/proxy?slug=careers" },
    { "source": "/success-stories", "destination": "/api/proxy?slug=success-stories" },
    { "source": "/get-started", "destination": "/api/proxy?slug=get-started" }
  ]
}
